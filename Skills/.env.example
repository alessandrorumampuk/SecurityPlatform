# Shared environment for Skills scripts — copy to Skills/.env and adjust.
# Loaded by Skills/env_loader.py (no external dependency).

# Social Media Crawler - default target URL
CRAWLER_DEFAULT_URL=https://www.example.com

# XSS Testing - default target URL; {xss_testing} is replaced by the payload
XSS_DEFAULT_URL=https://subdomain1.portswigger-labs.net/xss/xss.php?x={xss_testing}&context=html
